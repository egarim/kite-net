# A tour of Kite.NET: everything the articles show
module Tour

type Item = record(name: str, price: dec, qty: int)
type Light = enum(Red, Yellow, Green)

# one expression: = and the value
fn total(items: list<Item>) -> dec =
    items |> sum(i => i.price * i.qty)

# when: pattern -> value, else for the rest
fn label(n: int) -> str = when n
    0 -> "none"
    1 -> "one"
    < 5 -> "a few"
    else -> "many"

fn next_light(l: Light) -> Light = when l
    Light.Red -> Light.Green
    Light.Green -> Light.Yellow
    else -> Light.Red

# a block: indented lines, return gives the value
fn countdown(from: int) -> list<int>
    let out: list<int> = []
    let mut n = from
    while n > 0
        push(out, n)
        n -= 1
    return out

fn word_counts(text: str) -> map<str, int>
    let counts = map<str, int>()
    for w in words(lower(text))
        counts[w] = get(counts, w, 0) + 1
    return counts

fn cheapest(items: list<Item>) -> Item? =
    items |> sort_by(i => i.price) |> find(i => i.qty > 0)

fn receipt(items: list<Item>) -> str
    let lines = items |> map(i => "{i.qty} x {i.name}: {i.price * i.qty:0.00}")
    return join(lines, "\n") + "\ntotal: {total(items):0.00}"

fn safe_divide(a: dec, b: dec) -> dec
    if b == 0.0
        fail "cannot divide by zero"
    return a / b

fn main()
    let cart = [Item("tea", 2.5, 3), Item("cake", 4.0, 1), Item("milk", 1.2, 0)]
    print(receipt(cart))
    print("{len(cart)} lines: {label(len(cart))}")
    for i in 1..=3
        print(if i % 2 == 0 then "{i} is even" else "{i} is odd")
    let c = cheapest(cart)
    if c != none and c.qty > 0
        print("cheapest in stock: {c.name}")

test "total adds price times quantity"
    expect total([Item("a", 1.5, 2), Item("b", 1.0, 1)]) == 4.0
    expect total([]) == 0.0

test "labels and lights"
    expect label(0) == "none"
    expect label(3) == "a few"
    expect next_light(Light.Red) == Light.Green

test "loops and maps"
    expect countdown(3) |> join(",") == "3,2,1"
    expect get(word_counts("the cat the hat"), "the", 0) == 2
